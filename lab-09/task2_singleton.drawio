        <!-- Примітка про Singleton -->
        <mxCell id="note2" value="getInstance(): якщо екземпляра ще немає — створює службу (конструктор private), інакше повертає наявну.&lt;br&gt;Усі підрозділи отримують один і той самий об'єкт, тому рахунки гостей зберігаються в одному місці." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff9b1;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;size=14;" vertex="1" parent="1">
